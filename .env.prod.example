# Production environment (copy to .env.prod on the server)
DOMAIN=erp.example.com
ACME_EMAIL=you@example.com

POSTGRES_DB=erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=change-me-strong

# 48+ random bytes: openssl rand -base64 48
JWT_SECRET=change-me-in-production-change-me-in-production
JWT_ACCESS_TTL=PT30M

DEMO_MODE=true

# Only needed for the local-only pgadmin profile
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
